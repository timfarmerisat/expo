{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://somethingdifferent.lol/schemas/violet-action-contract.schema.json",
  "title": "Violet UI Action Contract",
  "type": "object",
  "required": [
    "version",
    "actions"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "actionType",
          "target",
          "permission",
          "success",
          "unavailable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "departmentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "group": {
            "enum": [
              "primary",
              "secondary",
              "create",
              "analyze",
              "communicate",
              "operate",
              "verify",
              "admin"
            ]
          },
          "actionType": {
            "enum": [
              "chat-prompt",
              "internal-route",
              "create-task",
              "request-approval",
              "connector-action",
              "verify",
              "create-asset",
              "export",
              "diagnose",
              "external-link",
              "automation"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "permission": {
            "enum": [
              "read",
              "write",
              "execute",
              "approve",
              "admin"
            ]
          },
          "connectionRequired": {
            "type": [
              "string",
              "null"
            ]
          },
          "confirmation": {
            "enum": [
              "none",
              "important-action",
              "always"
            ]
          },
          "success": {
            "type": "object",
            "required": [
              "result",
              "nextAction"
            ],
            "properties": {
              "result": {
                "type": "string"
              },
              "nextAction": {
                "type": "string"
              },
              "evidenceRequired": {
                "type": "boolean"
              }
            }
          },
          "unavailable": {
            "type": "object",
            "required": [
              "message",
              "recoveryAction"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "recoveryAction": {
                "type": "string"
              },
              "route": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}